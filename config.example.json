{
  "schema_version": 1,
  "defaults": {
    "pipeline": "default",
    "fallback_mode": "auto",
    "validation_level": "balanced",
    "minimum_profile": "standard",
    "timeout_seconds": 30,
    "ssl_verify": true,
    "log_level": "INFO",
    "log_to_file": false,
    "log_dir": "logs",
    "output_cleanup": true,
    "retry": {
      "max_attempts": 3,
      "multiplier": 1,
      "max_wait_seconds": 10
    }
  },
  "pipelines": {
    "default": [
      "answer_search",
      "source_search",
      "docs_search",
      "page_fetch"
    ],
    "research": [
      "source_search",
      "docs_search",
      "page_fetch",
      "site_map",
      "repo_wiki"
    ],
    "docs": [
      "docs_search",
      "page_fetch"
    ],
    "crawl": [
      "site_map",
      "site_crawl",
      "page_fetch"
    ]
  },
  "routes": {
    "answer_search": [
      "xai",
      "openai_compatible",
      "openai_responses"
    ],
    "source_search": [
      "exa",
      "zhipu",
      "tavily",
      "firecrawl"
    ],
    "docs_search": [
      "exa",
      "context7"
    ],
    "page_fetch": [
      "tavily",
      "firecrawl"
    ],
    "site_map": [
      "tavily",
      "firecrawl"
    ],
    "site_crawl": [
      "tavily",
      "firecrawl"
    ],
    "repo_wiki": [
      "deepwiki"
    ],
    "vertical_search": [
      "anysearch"
    ]
  },
  "profiles": {
    "standard": {
      "required_capabilities": [
        "answer_search",
        "docs_search",
        "page_fetch"
      ],
      "optional_capabilities": [
        "source_search",
        "site_map",
        "site_crawl",
        "repo_wiki",
        "vertical_search"
      ]
    },
    "minimal": {
      "required_capabilities": [
        "answer_search"
      ],
      "optional_capabilities": [
        "source_search",
        "docs_search",
        "page_fetch"
      ]
    },
    "off": {
      "required_capabilities": [],
      "optional_capabilities": []
    }
  },
  "providers": {
    "xai": {
      "enabled": false,
      "adapter": "xai_responses",
      "capabilities": [
        "answer_search"
      ],
      "base_url": "https://api.x.ai/v1",
      "api_key": "",
      "api_key_env": "XAI_API_KEY",
      "settings": {
        "model": "grok-4-fast",
        "tools": [
          "web_search",
          "x_search"
        ]
      }
    },
    "openai_compatible": {
      "enabled": false,
      "adapter": "openai_chat_completions",
      "capabilities": [
        "answer_search"
      ],
      "base_url": "https://api.openai.com/v1",
      "api_key": "",
      "api_key_env": "OPENAI_COMPATIBLE_API_KEY",
      "settings": {
        "model": "gpt-4.1",
        "stream": false,
        "tools": [],
        "tool_choice": ""
      }
    },
    "openai_responses": {
      "enabled": false,
      "adapter": "openai_responses",
      "capabilities": [
        "answer_search"
      ],
      "base_url": "https://api.openai.com/v1",
      "api_key": "",
      "api_key_env": "OPENAI_API_KEY",
      "settings": {
        "model": "gpt-4.1"
      }
    },
    "exa": {
      "enabled": false,
      "adapter": "exa",
      "capabilities": [
        "source_search",
        "docs_search",
        "page_fetch"
      ],
      "base_url": "https://api.exa.ai",
      "api_key": "",
      "api_key_env": "EXA_API_KEY",
      "settings": {
        "timeout_seconds": 30
      }
    },
    "context7": {
      "enabled": false,
      "adapter": "context7",
      "capabilities": [
        "docs_search"
      ],
      "base_url": "https://context7.com",
      "api_key": "",
      "api_key_env": "CONTEXT7_API_KEY",
      "settings": {
        "timeout_seconds": 30
      }
    },
    "zhipu": {
      "enabled": false,
      "adapter": "zhipu_web_search",
      "capabilities": [
        "source_search"
      ],
      "base_url": "https://open.bigmodel.cn/api",
      "api_key": "",
      "api_key_env": "ZHIPU_API_KEY",
      "settings": {
        "search_engine": "search_std",
        "timeout_seconds": 30
      }
    },
    "tavily": {
      "enabled": false,
      "adapter": "tavily",
      "capabilities": [
        "source_search",
        "page_fetch",
        "site_map",
        "site_crawl"
      ],
      "base_url": "https://api.tavily.com",
      "api_key": "",
      "api_key_env": "TAVILY_API_KEY",
      "settings": {
        "timeout_seconds": 30
      }
    },
    "firecrawl": {
      "enabled": false,
      "adapter": "firecrawl",
      "capabilities": [
        "source_search",
        "page_fetch",
        "site_map",
        "site_crawl"
      ],
      "base_url": "https://api.firecrawl.dev/v2",
      "api_key": "",
      "api_key_env": "FIRECRAWL_API_KEY",
      "settings": {
        "timeout_seconds": 30
      }
    },
    "ddg": {
      "enabled": false,
      "adapter": "mcp_stdio",
      "capabilities": [
        "source_search",
        "page_fetch"
      ],
      "base_url": "",
      "api_key": "",
      "api_key_env": "",
      "aliases": [
        "ddg-search",
        "duckduckgo",
        "duckduckgo-mcp"
      ],
      "settings": {
        "direct_only": true,
        "anonymous_allowed": true,
        "timeout_seconds": 60,
        "command": "uvx",
        "args": [
          "duckduckgo-mcp-server",
          "--transport",
          "stdio"
        ],
        "env": {
          "DDG_SAFE_SEARCH": "MODERATE",
          "DDG_REGION": "cn-zh"
        },
        "tools": {
          "search": "search",
          "fetch_content": "fetch_content"
        }
      }
    },
    "freecrawl": {
      "enabled": false,
      "adapter": "mcp_stdio",
      "capabilities": [
        "source_search",
        "page_fetch",
        "site_crawl"
      ],
      "base_url": "",
      "api_key": "",
      "api_key_env": "",
      "aliases": [
        "freecrawl-mcp"
      ],
      "settings": {
        "direct_only": true,
        "anonymous_allowed": true,
        "timeout_seconds": 160,
        "command": "uvx",
        "args": [
          "freecrawl-mcp"
        ],
        "env": {
          "FREECRAWL_TRANSPORT": "stdio",
          "FREECRAWL_HEADLESS": "true",
          "FREECRAWL_TIMEOUT": "160",
          "PYTHONIOENCODING": "utf-8"
        },
        "tools": {
          "search": "mcp__freecrawl__search",
          "scrape": "mcp__freecrawl__scrape",
          "crawl": "mcp__freecrawl__crawl",
          "deep_research": "mcp__freecrawl__deep_research"
        }
      }
    },
    "deepwiki": {
      "enabled": true,
      "adapter": "deepwiki",
      "capabilities": [
        "repo_wiki"
      ],
      "base_url": "https://mcp.deepwiki.com/mcp",
      "api_key": "",
      "api_key_env": "DEEPWIKI_API_KEY",
      "settings": {
        "timeout_seconds": 30,
        "anonymous_allowed": true
      }
    },
    "anysearch": {
      "enabled": true,
      "adapter": "anysearch_mcp",
      "capabilities": [
        "vertical_search",
        "page_fetch"
      ],
      "base_url": "https://api.anysearch.com/mcp",
      "api_key": "",
      "api_key_env": "ANYSEARCH_API_KEY",
      "settings": {
        "timeout_seconds": 30,
        "anonymous_allowed": true
      }
    }
  }
}
